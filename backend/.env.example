# Servidor
PORT=3001
NODE_ENV=development

# Segurança e CORS
ALLOWED_ORIGIN=http://localhost:5173

# Autenticação e Criptografia
JWT_SECRET=
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12

# Opcional: cria um usuário administrador apenas em desenvolvimento.
# Defina uma senha longa localmente; não use valores de exemplo em produção.
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
